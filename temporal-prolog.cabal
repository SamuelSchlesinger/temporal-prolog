cabal-version:   3.14
name:            temporal-prolog
version:         0.1.0.0
license:         MIT
license-file:    LICENSE
synopsis:        A temporal logic programming language based on Sakuragawa (1986)
description:
    Temporal Prolog extends standard Prolog with temporal operators from
    linear temporal logic, computing a sequence of worlds (sets of ground
    atoms) over discrete time steps. Conditions may reference past worlds
    via operators like @\@@ (previous), @#@ (has-been), and @?@ (once),
    while results may project into the future with @always@, @until@,
    @atnext@, and @next@. Includes a five-step normalization pipeline, a
    condition-1 least-fixed-point fast path, finite SCC-ordered classical
    minimal-model execution for recursion through negation, and backward
    chaining for recursive pattern functions.
category:        Language
author:          Samuel Schlesinger
maintainer:      sgschlesinger@gmail.com
build-type:      Simple
tested-with:     GHC == 9.6.7
extra-doc-files:
    CHANGELOG.md
    README.md
    TESTING.md
    examples/WALKTHROUGH.md
    output/pdf/temporal-prolog-specification.pdf
    spec/temporal-prolog.tex
extra-source-files:
    benchmarks/README.md
    benchmarks/results-2026-07-21.md
    benchmarks/run.sh
    conformance/README.md
    conformance/run.sh
    conformance/cases/*.tpl
    conformance/rejections/*.tpl
    examples/*.tpl
    examples/model-checking/*.tpl
    examples/model-checking/*.tpmc
    examples/model-checking/*.expected
    examples/model-checking/*.expected.dot
    examples/model-checking/README.md
    rust/Cargo.lock
    rust/Cargo.toml
    rust/README.md
    rust/src/*.rs
    rust/src/bin/*.rs
    rust/tests/*.rs

common warnings
    ghc-options: -Wall

library
    import:           warnings
    exposed-modules:
        TemporalProlog.Syntax
        TemporalProlog.Unification
        TemporalProlog.Parser
        TemporalProlog.PrettyPrint
        TemporalProlog.Normalizer
        TemporalProlog.Interpreter
        TemporalProlog.Batch
        TemporalProlog.Scenario
        TemporalProlog.ModelChecker
    build-depends:
        base ^>=4.18.3.0,
        bytestring >=0.11 && <0.13,
        containers >=0.6 && <0.8,
        megaparsec >=9.6 && <10,
        mtl >=2.3 && <2.4,
        text >=2.0 && <2.2
    hs-source-dirs:   src
    default-language: Haskell2010

test-suite temporal-prolog-test
    import:           warnings
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    build-depends:
        base ^>=4.18.3.0,
        temporal-prolog,
        containers,
        hspec,
        megaparsec
    hs-source-dirs:   test
    default-language: Haskell2010

executable temporal-prolog
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base ^>=4.18.3.0,
        temporal-prolog,
        containers,
        haskeline >=0.8 && <0.9,
        megaparsec,
        mtl,
        text
    hs-source-dirs:   app
    default-language: Haskell2010

executable temporal-prolog-bench
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base ^>=4.18.3.0,
        temporal-prolog,
        containers
    hs-source-dirs:   benchmark
    default-language: Haskell2010

executable temporal-prolog-check
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base ^>=4.18.3.0,
        temporal-prolog,
        directory >=1.3 && <1.4,
        filepath >=1.4 && <1.6,
        megaparsec
    hs-source-dirs:   model-checker
    default-language: Haskell2010

executable temporal-prolog-run
    import:           warnings
    main-is:          Main.hs
    build-depends:
        base ^>=4.18.3.0,
        temporal-prolog,
        containers,
        megaparsec
    hs-source-dirs:   runner
    default-language: Haskell2010

source-repository head
    type:     git
    location: https://github.com/SamuelSchlesinger/temporal-prolog.git
