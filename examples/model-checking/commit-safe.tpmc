name atomic-commit-safe
program commit.tpl
steps 4

assert 0 begin(tx1)

% Independently quantify over every valid yes/no vote from each participant.
choose 1 p1_vote vote_yes(tx1, p1)
choose 1 p1_vote vote_no(tx1, p1)
choose 1 p2_vote vote_yes(tx1, p2)
choose 1 p2_vote vote_no(tx1, p2)

invariant atomic_decision forbids violation(atomic_decision, T)
